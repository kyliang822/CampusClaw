AI_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
AI_API_KEY=填入你的课程网关密钥
AI_MODEL=course-chat
AI_RETRIEVAL_MODE=hybrid

# External tools are read from the process environment (Compose env_file injects it).
# For run.py use: export CAMPUS_EXTERNAL_TOOLS='[...]'
# MCP example (replace endpoint; allow only intended tools):
# CAMPUS_EXTERNAL_TOOLS=[{"id":"school","kind":"mcp","url":"http://127.0.0.1:9000/mcp","allowed_tools":["lookup"],"token_env":"SCHOOL_MCP_TOKEN"}]
